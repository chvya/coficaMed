# ================================================================
#  CodificaMed - configuración. Copie este archivo como ".env".
#  No suba el .env al repositorio: contiene sus claves.
# ================================================================

# --- Proveedor de LLM por defecto: ollama (local), claude u openai ---
# También se cambia desde el selector de la interfaz.
LLM_PROVIDER=ollama

# --- Modelo local (Ollama) ---
OLLAMA_HOST=http://localhost:11434
# Para un equipo sin GPU y 8 GB de RAM. Con GPU de 8 GB puede usar qwen2.5:7b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=900

# --- Embeddings para la recuperación semántica (siempre locales) ---
# ollama = bge-m3 ; lexico = solo búsqueda BM25 (sin embeddings)
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=bge-m3

# --- API externa 1: Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- API externa 2: cualquier servicio con formato OpenAI ---
# OpenAI:  OPENAI_BASE_URL=https://api.openai.com/v1            OPENAI_MODEL=gpt-4o-mini
# Gemini:  OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   OPENAI_MODEL=gemini-flash-lite-latest
# Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Recuperación de códigos ---
TOP_K_CANDIDATOS=6
PESO_SEMANTICO=0.1
PESO_LEXICO=1.0

PUERTO=8000
